DB_HOST=db_host
DB_PORT=db_port
DB_NAME=db_name
DB_USER=db_user
DB_PASS=db_password

# Optional: OMOP vocabulary database (concept_synonym lives here).
# Defaults to DB_NAME if not set.
OMOP_DB_NAME=omop_vocab

APP_ENV=development
APP_DEBUG=true
# How often (seconds) the background refresh cycle runs. Each cycle first runs a cheap
# fingerprint probe (COUNT/MAX over latest_distributions + OMOP tables); if the data is
# unchanged the expensive reload is SKIPPED, so this value only governs how quickly a
# genuine data change is picked up. 300 is a sensible production default; a low value like
# 60 is fine for testing the skip path. Blind spot: an in-place edit that preserves row
# count and MAX(concept_id) is not detected — restart or lower the TTL if that matters.
STORE_REFRESH_TTL=300
DEFAULT_THRESHOLD=60

# Log level: INFO (default) or DEBUG (enables per-step timing in the SQL resolver
# to diagnose slow searches — shows in-memory filter time, db connection acquire time, etc.)
LOG_LEVEL=INFO

# Dev only (APP_ENV=development): path for the warm-up snapshot cache. On uvicorn --reload
# the tokenised concepts + synonym/acronym maps are restored from this file instead of
# re-querying MySQL, making reloads near-instant. Rebuilt automatically if deleted.
# It does NOT track code/config changes — delete it after editing the tokeniser, rules.json,
# or the concept load query to force a fresh rebuild. Ignored entirely in production.
CONCEPTS_CACHE_PATH=.concepts_cache.pkl

FUZZY_TOKEN_OVERLAP=true
FUZZY_TOKEN_MIN_SCORE=85
RESOLVER_MAX_MATCHES=5

# Very experimental acronym extraction feature
# Acronyms are calculated eagerly on concept load (per resolver instance).
# The acronym index is then cached in memory inside QueryParser and reused
# until the resolver's concept list changes.
ACRONYM_ENABLED=true

# Applies a logarithmic boost to concepts that are with multiple collections,
# to de-saturate larger datasets monopolising omop concepts purely on size.
#
# Can be set to 0 to disable additional weighting.
COLLECTION_BOOST_WEIGHT=1.5

# Concept resolver backend for /extract.
# "sql" (default): MySQL+MedCAT lookup, same as /concepts/search.
# "fuzzy": in-memory fuzzy matching via FuzzyConceptResolver.
RESOLVER_BACKEND=sql

# MedCAT service for clinical term expansion in /concepts/search and SQL resolver.
MEDCAT_URL=https://your-medcat-host
MEDCAT_MIN_ACC=0.5

# Scoring tiers for concept search (used in /concepts/search and SQL resolver).
# Exact name match > contains match > prefix match; synonym boost applied on top.
CONCEPT_MATCH_SCORE_EXACT=1000
CONCEPT_MATCH_SCORE_CONTAINS=500
CONCEPT_MATCH_SCORE_PREFIX=100
CONCEPT_MATCH_SCORE_SYNONYM=1000
CONCEPT_MATCH_SCORE_TOKEN=50