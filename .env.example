DB_HOST=db_host
DB_PORT=db_port
DB_NAME=db_name
DB_USER=db_user
DB_PASS=db_password

# Optional: OMOP vocabulary database (concept_synonym lives here).
# Defaults to DB_NAME if not set.
OMOP_DB_NAME=omop_vocab

OMOP_VIEW=distributions_and_concept_view
APP_ENV=development
APP_DEBUG=true
STORE_REFRESH_TTL=60
DEFAULT_THRESHOLD=60

FUZZY_TOKEN_OVERLAP=true
FUZZY_TOKEN_MIN_SCORE=85
RESOLVER_MAX_MATCHES=5

# Very experimental acronym extraction feature
# Acronyms are calculated eagerly on concept load (per resolver instance).
# The acronym index is then cached in memory inside QueryParser and reused
# until the resolver's concept list changes.
ACRONYM_ENABLED=true

# Applies a logarithmic boost to concepts that are with multiple collections,
# to de-saturate larger datasets monopolising omop concepts purely on size.
#
# Can be set to 0 to disable additional weighting.
COLLECTION_BOOST_WEIGHT=1.5

# Concept resolver backend for /extract.
# "sql" (default): MySQL+MedCAT lookup, same as /concepts/search.
# "fuzzy": in-memory fuzzy matching via FuzzyConceptResolver.
RESOLVER_BACKEND=sql

# MedCAT service for clinical term expansion in /concepts/search and SQL resolver.
MEDCAT_URL=https://your-medcat-host
MEDCAT_MIN_ACC=0.5

# Scoring tiers for concept search (used in /concepts/search and SQL resolver).
# Exact name match > contains match > prefix match; synonym boost applied on top.
CONCEPT_MATCH_SCORE_EXACT=1000
CONCEPT_MATCH_SCORE_CONTAINS=500
CONCEPT_MATCH_SCORE_PREFIX=100
CONCEPT_MATCH_SCORE_SYNONYM=1000
